+    alias = fixture$alias, verbose = FALSE,
+    metadata = list(reporting_level = "sidecar-not-payload"))
+  captured <- m2_capture(saved, path, fixture)
+  row <- data.table(pip_id = "LCA_2015_SLCHBS_INC_GPWG",
+    path_metadata = as.character(saved$path),
+    version_id_metadata = saved$version_id)
