+test_that("public rebuild receipts retain unchanged output and effective parents", {
+  fixture <- m2_fixture()
+  root <- m2_request(file.path(fixture$root, "receipt-root.qs2"), "qs2")
+  child <- m2_request(file.path(fixture$root, "receipt-child.qs2"), "qs2",
+    list(list(path = root$path, version_id = NULL)))
+  root_value <- 1L
+  calls <- character()
+  builder <- function(path, parents) {
+    calls <<- c(calls, basename(path))
+    list(x = if (basename(path) == "receipt-root.qs2") root_value else 9L,
+      metadata = list(unit = "fixture"))
+  }
+  plan <- function() stamp::st_plan_rebuild(root$path,
+    include_targets = TRUE, requests = list(root, child))
+  initial <- stamp::st_rebuild(plan(), rebuild_fun = builder)
+  expect_identical(initial$status, c("built", "built"))
+  for (i in seq_len(nrow(initial))) {
+    receipt <- stamp::st_execution_info(initial$path[[i]],
+      initial$receipt_id[[i]], fixture$alias)
+    expect_identical(receipt$state, "success")
+    expect_identical(receipt$receipt_id, initial$receipt_id[[i]])
+    expect_identical(receipt$version_id, initial$version_id[[i]])
+  }
+  original <- stamp::st_read_sidecar(child$path, fixture$alias,
+    initial$version_id[[2L]])
+  child$parents[[1L]]$version_id <- initial$version_id[[1L]]
+  root$components$calculation$hash <- strrep("b", 64L)
+  root_value <- 2L
+  calls <- character()
+  changed <- stamp::st_rebuild(plan(), rebuild_fun = builder)
+  expect_identical(calls, c("receipt-root.qs2", "receipt-child.qs2"))
+  expect_identical(changed$status, c("built", "unchanged"))
+  expect_false(identical(changed$version_id[[1L]], initial$version_id[[1L]]))
+  expect_identical(changed$version_id[[2L]], initial$version_id[[2L]])
+  info <- stamp::st_execution_info(child$path,
+    changed$receipt_id[[2L]], fixture$alias)
+  expect_identical(info$state, "success")
+  expect_identical(info$receipt_id, changed$receipt_id[[2L]])
+  expect_identical(info$receipt$outcome, "success_unchanged")
+  expect_identical(info$receipt$output$version_id, initial$version_id[[2L]])
+  expect_identical(info$receipt$request$parents[[1L]]$version_id,
+    changed$version_id[[1L]])
+  expect_identical(stamp::st_read_sidecar(child$path, fixture$alias,
+    initial$version_id[[2L]]), original)
+  expect_error(stamp::st_execution_info(child$path,
+    "deliberately-unknown-receipt", fixture$alias))
+  child$parents[[1L]]$version_id <- changed$version_id[[1L]]
+  calls <- character()
+  repeated <- stamp::st_rebuild(plan(), rebuild_fun = builder)
+  expect_identical(repeated$status, c("skipped", "skipped"))
+  expect_identical(repeated$receipt_id, changed$receipt_id)
+  expect_identical(calls, character())
+})
