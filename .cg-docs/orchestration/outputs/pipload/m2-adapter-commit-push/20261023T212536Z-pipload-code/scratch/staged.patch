+# Only captured sidecar members can be faulted, with byte-for-byte restoration.
+m2_fault_sidecar <- function(captured, fixture, member, fault,
+                             envir = parent.frame()) {
+  stopifnot(member %in% c("sidecar.json", "sidecar.qs2"),
+    fault %in% c("missing", "corrupt"))
+  directory <- m2_guard(captured$directory, fixture$root)
+  path <- m2_guard(file.path(directory, member), directory)
+  original <- readBin(path, "raw", n = file.info(path)$size)
+  withr::defer({
+    m2_guard(directory, fixture$root)
+    if (file.exists(path)) m2_guard(path, directory)
+    writeBin(original, path)
+    stopifnot(identical(readBin(path, "raw", n = file.info(path)$size),
+      original))
+  }, envir = envir)
+  if (fault == "missing") {
+    stopifnot(file.remove(path))
+  } else {
+    writeBin(charToRaw("deliberately corrupt fixture sidecar"), path)
+  }
+  invisible(NULL)
+}
+
+for (sidecar_format in c("json", "qs2", "both")) {
+  for (fault in c("missing", "corrupt")) {
+    # Legacy both-mode permits a diagnostic fallback to the surviving copy;
+    # modern both-mode instead requires each declared sidecar.
+    for (modern in if (sidecar_format == "both") TRUE else c(TRUE, FALSE)) {
+      local({
+        mode <- sidecar_format
+        damage <- fault
+        is_modern <- modern
+        test_that(paste("strict historic sidecars reject", damage, mode,
+          "with modern =", is_modern, "without current fallback"), {
+          fixture <- m2_fixture(meta_format = mode)
+          path <- "fault.qs2"
+          args <- list(id = path, alias = fixture$alias, verbose = FALSE)
+          if (is_modern) {
+            args$request <- m2_request(path, "qs2", unit = "old")
+            args$semantic_schema <- m2_schema()
+          }
+          old <- do.call(pip_write, c(list(x = 1:3,
+            metadata = list(unit = "old")), args))
+          captured <- m2_capture(old, path, fixture)
+          original <- stamp::st_read_sidecar(path, fixture$alias, old$version_id)
+          if (is_modern) args$request <- m2_request(path, "qs2", unit = "new")
+          new <- do.call(pip_write, c(list(x = 4:6,
+            metadata = list(unit = "new")), args))
+          current <- m2_capture(new, path, fixture)
+          current_metadata <- stamp::st_read_sidecar(path, fixture$alias,
+            new$version_id)
+          # Both-mode faults must exercise each required member independently.
+          members <- if (mode == "both") c("json", "qs2") else mode
+          for (extension in members) {
+            (function() {
+              hashes <- tools::md5sum(c(file.path(captured$directory,
+                "artifact"), list.files(current$directory, full.names = TRUE)))
+              m2_fault_sidecar(captured, fixture,
+                paste0("sidecar.", extension), damage, envir = environment())
+              expect_error(stamp::st_read_sidecar(path, fixture$alias,
+                old$version_id))
+              expect_error(pip_read(path, version = old$version_id,
+                alias = fixture$alias, verbose = FALSE, metadata_only = TRUE))
+              # Legacy payload recovery is not modern semantic proof.
+              if (!is_modern) {
+                expect_identical(pip_read(path, version = old$version_id,
+                  alias = fixture$alias, verbose = FALSE), 1:3)
+              }
+              expect_identical(stamp::st_read_sidecar(path, fixture$alias),
+                current_metadata)
+              expect_identical(pip_read(path, version = new$version_id,
+                alias = fixture$alias, verbose = FALSE), 4:6)
+              expect_identical(tools::md5sum(names(hashes)), hashes)
+            })()
+            expect_identical(stamp::st_read_sidecar(path, fixture$alias,
+              old$version_id), original)
+          }
+        })
+      })
+    }
+  }
+}
