+test_that("pip_write forwards modern root and child proof and real save results", {
+  fixture <- m2_fixture()
+  payload <- data.frame(id = 1:2, value = c(10L, 20L))
+  for (format in c("fst", "qs2")) {
+    path <- paste0("root.", format)
+    request <- m2_request(path, format)
+    args <- list(x = payload, id = path, format = format,
+      metadata = list(unit = "fixture"), alias = fixture$alias, pk = "id",
+      verbose = FALSE, request = request, semantic_schema = m2_schema(),
+      parents = list())
+    first <- withVisible(do.call(pip_write, args))
+    captured <- m2_capture(first$value, path, fixture)
+    expect_false(first$visible)
+    expect_named(first$value, c("path", "metadata", "version_id"))
+    metadata <- stamp::st_read_sidecar(path, fixture$alias, captured$pin)
+    expect_identical(first$value$metadata$execution, metadata$execution)
+    expect_identical(metadata$attrs$stamp,
+      list(protocol = "stamp-sidecar-v1", semantic = TRUE,
+        execution = TRUE, sidecars = "both"))
+    expect_identical(as.character(metadata$pk$keys), "id")
+    proof <- m2_decode(metadata$execution$request)
+    expect_identical(proof$schema, 1L)
+    expect_identical(proof$path, first$value$path)
+    expect_true(proof$root)
+    expect_identical(proof$parents, list())
+    expect_identical(proof$components, request$components)
+    expect_identical(proof$semantic_schema, request$semantic_schema)
+    expect_identical(proof$semantic, request$semantic)
+    expect_identical(proof$format, format)
+    m2_expect_table(pip_read(path, format, captured$pin, fixture$alias,
+      verbose = FALSE), payload)
+
+    repeated <- withVisible(do.call(pip_write, args))
+    m2_capture(repeated$value, path, fixture)
+    producer_args <- args
+    names(producer_args)[names(producer_args) == "id"] <- "file"
+    producer <- withVisible(do.call(stamp::st_save, producer_args))
+    expect_false(repeated$visible)
+    expect_identical(repeated, producer)
+    expect_true(repeated$value$skipped)
+    expect_identical(repeated$value$version_id, captured$pin)
+    expect_identical(stamp::st_execution_info(path,
+      alias = fixture$alias)$state, "absent")
+
+    child_path <- paste0("child.", format)
+    parents <- list(list(path = path, version_id = captured$pin))
+    child_request <- m2_request(child_path, format, parents)
+    child <- withVisible(pip_write(payload, child_path, format = format,
+      alias = fixture$alias, pk = "id", verbose = FALSE,
+      metadata = list(unit = "fixture"), parents = parents,
+      request = child_request, semantic_schema = m2_schema()))
+    m2_capture(child$value, child_path, fixture)
+    expect_false(child$visible)
+    child_metadata <- stamp::st_read_sidecar(child_path, fixture$alias,
+      child$value$version_id)
+    child_proof <- m2_decode(child_metadata$execution$request)
+    expect_false(child_proof$root)
+    expect_identical(child_proof$components, child_request$components)
+    expect_identical(child_proof$parents,
+      list(list(path = first$value$path, version_id = captured$pin)))
+    m2_expect_table(pip_read(child_path, format, child$value$version_id,
+      fixture$alias, verbose = FALSE), payload)
+
+    bad <- request
+    bad$components$helper <- NULL
+    expect_error(pip_write(payload, path,
+      format = format, alias = fixture$alias, verbose = FALSE,
+      pk = "id", metadata = list(unit = "fixture"), request = bad,
+      semantic_schema = m2_schema()))
+    bad <- request
+    bad$components$helper$hash <- "not-a-fingerprint"
+    expect_error(pip_write(payload, path, format = format,
+      alias = fixture$alias, verbose = FALSE, pk = "id",
+      metadata = list(unit = "fixture"), request = bad))
+    expect_error(pip_write(payload, path, format = format,
+      alias = fixture$alias, verbose = FALSE, pk = "id",
+      metadata = list(unit = 1L), request = request))
+    expect_error(pip_write(payload, child_path, format = format,
+      alias = fixture$alias, verbose = FALSE, pk = "id",
+      metadata = list(unit = "fixture"), request = child_request,
+      parents = list(list(path = path, version_id = "unknown-pin"))))
+    expect_identical(stamp::st_read_sidecar(path, fixture$alias,
+      captured$pin), metadata)
+  }
+})
