+    write = function(x, path, ...) saveRDS(x, path), extensions = format)
+  path <- paste0("counted.", format)
+  saved <- pip_write(1:3, path, format = format, alias = fixture$alias,
+    verbose = FALSE, metadata = list(unit = "fixture"),
+    request = m2_request(path, format), semantic_schema = m2_schema())
+  m2_capture(saved, path, fixture)
+  expect_identical(pip_read(path, format = NULL, version = saved$version_id,
+    alias = fixture$alias, verbose = FALSE), 1:3)
+  expect_identical(reads, 1L)
+  reads <- 0L
+  fail_read <- TRUE
+  metadata <- stamp::st_read_sidecar(path, fixture$alias, saved$version_id)
+  expect_identical(pip_read(path, format = NULL, version = saved$version_id,
+    alias = fixture$alias, verbose = FALSE, metadata_only = TRUE), metadata)
+  expect_error(pip_read(path, format = "qs2", version = saved$version_id,
+    alias = fixture$alias, verbose = FALSE, metadata_only = TRUE),
+    "Mismatch")
+  expect_error(pip_read(path, format = NULL, version = "unavailable-pin",
+    alias = fixture$alias, verbose = FALSE, metadata_only = TRUE))
+  expect_identical(reads, 0L)
+
+  invalid <- list(NULL, NA_character_, NA, character(), "", c("a", "b"),
+    0, -1, 1, TRUE, FALSE, "available", "latest", "current", "select",
+    "pick", "choose", "-1", "0", "+1")
+  for (pin in invalid) {
+    error <- tryCatch(pip_read(path, format = NULL, version = pin,
+      alias = fixture$alias, verbose = FALSE, metadata_only = TRUE),
+      error = identity)
+    expect_s3_class(error, "error")
+    expect_match(conditionMessage(error),
+      "[Ee]xact|[Nn]onempty|[Ss]calar|[Cc]haracter|[Ss]elector")
+    # An unresolved alias must not replace the pin-validation error.
+    unresolved <- tryCatch(pip_read(path, format = NULL, version = pin,
+      alias = paste0(fixture$alias, "-not-registered"), verbose = FALSE,
+      metadata_only = TRUE), error = identity)
+    expect_s3_class(unresolved, "error")
+    expect_identical(conditionMessage(unresolved), conditionMessage(error))
+    expect_identical(reads, 0L)
+  }
+})
