+m2_catalog_fault <- function(fixture, pin, fault, envir = parent.frame()) {
+  stopifnot(fault %in% c("error", "warning", "duplicate", "invalid",
+    "hash_na", "hash_empty", "hash_blank"))
+  path <- m2_guard(file.path(fixture$root, ".stamp", "catalog.qs2"),
+    fixture$root)
+  original <- readBin(path, "raw", n = file.info(path)$size)
+  withr::defer({
+    m2_guard(path, fixture$root)
+    writeBin(original, path)
+    stopifnot(identical(readBin(path, "raw", n = file.info(path)$size),
+      original))
+  }, envir = envir)
+  catalog <- qs2::qs_read(m2_guard(path, fixture$root))
+  selected <- which(catalog$versions$version_id == pin)
+  stopifnot(length(selected) == 1L)
+  if (fault == "error") {
+    writeBin(charToRaw("deliberately unreadable fixture catalog"),
+      m2_guard(path, fixture$root))
+  } else {
+    if (fault == "warning") catalog$versions[selected, created_at := NA_character_]
+    if (fault == "invalid") catalog$versions[selected, sidecar_format := "invalid"]
+    if (fault == "hash_na") catalog$versions[selected, content_hash := NA_character_]
+    if (fault == "hash_empty") catalog$versions[selected, content_hash := ""]
+    if (fault == "hash_blank") catalog$versions[selected, content_hash := " "]
+    if (fault == "duplicate") {
+      catalog$versions <- rbindlist(list(catalog$versions,
+        catalog$versions[selected]))
+    }
+    qs2::qs_save(catalog, m2_guard(path, fixture$root))
+  }
+  invisible(NULL)
+}
+
+m2_payload_fault <- function(captured, fixture, fault,
+                             envir = parent.frame()) {
+  stopifnot(fault %in% c("missing", "corrupt"))
+  directory <- m2_guard(captured$directory, fixture$root)
+  path <- m2_guard(file.path(directory, "artifact"), directory)
+  original <- readBin(path, "raw", n = file.info(path)$size)
+  withr::defer({
+    m2_guard(directory, fixture$root)
+    if (file.exists(path)) m2_guard(path, directory)
+    writeBin(original, path)
+    stopifnot(identical(readBin(path, "raw", n = file.info(path)$size),
+      original))
+  }, envir = envir)
+  if (fault == "missing") {
+    stopifnot(file.remove(m2_guard(path, directory)))
+  } else {
+    writeBin(charToRaw("deliberately corrupt fixture payload"),
+      m2_guard(path, directory))
+  }
+  invisible(NULL)
+}
