+# Phase 2 loader fixtures use real stamp storage; only PIP discovery is replaced.
+m2_loader_plumbing <- function(fixture, envir = parent.frame()) {
+  testthat::local_mocked_bindings(
+    get_wrk_release = function(...) list(release = "fixture"),
+    get_pip_folders = function(folder, ...) {
+      stopifnot(folder %in% c("aux_data", "pip_data", "pip_metadata"))
+      fixture$root
+    },
+    .package = "pipfun", .env = envir)
+}
+
+m2_loader_save <- function(fixture, path, payload, format) {
+  saved <- stamp::st_save(payload, path, format = format,
+    alias = fixture$alias, pk = "id", verbose = FALSE)
+  m2_capture(saved, path, fixture)
+  return(saved)
+}
