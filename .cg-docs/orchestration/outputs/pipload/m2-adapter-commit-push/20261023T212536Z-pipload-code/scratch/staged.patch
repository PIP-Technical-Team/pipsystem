+# Capture only the three approved consumer diagnostics, never producer warnings.
+m2_enrich_capture <- function(inv, fields = "reporting_level") {
+  warnings <- list()
+  value <- tryCatch(withCallingHandlers(
+    pip_inv_enrich(copy(inv), fields = fields),
+    warning = function(w) {
+      if (inherits(w, c("pip_inv_enrich_read_error",
+          "pip_inv_enrich_missing_meta", "pip_inv_enrich_no_version_col"))) {
+        warnings[[length(warnings) + 1L]] <<- w
+        invokeRestart("muffleWarning")
+      }
+    }), error = identity)
+  return(list(value = value, warnings = warnings))
+}
+
+m2_expect_enrich_warnings <- function(result, read = 0L, missing = 0L,
+                                      no_version = 0L) {
+  classes <- c("pip_inv_enrich_read_error", "pip_inv_enrich_missing_meta",
+    "pip_inv_enrich_no_version_col")
+  actual <- vapply(classes, function(class) {
+    sum(vapply(result$warnings, inherits, logical(1L), what = class))
+  }, integer(1L))
+  expect_identical(unname(actual), as.integer(c(read, missing, no_version)))
+}
