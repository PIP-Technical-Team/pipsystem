+m2_enrich_counts <- function(envir = parent.frame()) {
+  counts <- new.env(parent = emptyenv())
+  instrument <- function(name) {
+    force(name)
+    counts[[name]] <- 0L
+    stopifnot(!inherits(getExportedValue("stamp", name), "functionWithTrace"))
+    suppressMessages(trace(name, where = asNamespace("stamp"), print = FALSE,
+      tracer = function() counts[[name]] <- counts[[name]] + 1L))
+    withr::defer(suppressMessages(untrace(name,
+      where = asNamespace("stamp"))), envir = envir)
