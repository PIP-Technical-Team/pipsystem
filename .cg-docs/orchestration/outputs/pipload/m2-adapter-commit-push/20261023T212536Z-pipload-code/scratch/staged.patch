-# Helper: write a metadata list to a stamp-layout temp path and return an inv
-# data.table row pointing at it.
+# Keep stores available for their unique aliases: stamp has no public removal API.
+enrich_tempdir <- function(envir = parent.frame()) {
+  parent <- Sys.getenv("PIPLOAD_TEST_STORE_ROOT", unset = tempdir())
+  stopifnot(length(parent) == 1L, nzchar(parent), dir.exists(parent),
+    fs::is_absolute_path(parent))
+  parts <- strsplit(gsub("\\\\", "/", parent), "/", fixed = TRUE)[[1L]]
+  stopifnot(!any(parts %in% c(".", "..")))
+  cursor <- parent
+  repeat {
+    target <- Sys.readlink(cursor)
+    if (isTRUE(fs::is_link(cursor)) ||
+        (length(target) == 1L && !is.na(target) && nzchar(target))) {
+      stop("Linked or junction fixture ancestry is forbidden")
+    }
+    ancestor <- dirname(cursor)
+    if (identical(ancestor, cursor)) break
+    cursor <- ancestor
+  }
+  parent <- as.character(fs::path_real(parent))
+  dir <- tempfile(paste0("enrich-", Sys.getpid(), "-"), tmpdir = parent)
+  stopifnot(!file.exists(dir), dir.create(dir))
+  stopifnot(!isTRUE(fs::is_link(dir)))
+  dir <- as.character(fs::path_real(dir))
+  approved <- paste0(sub("/+$", "", parent), "/")
+  if (.Platform$OS.type == "windows") {
+    stopifnot(startsWith(tolower(dir), tolower(approved)))
+  } else {
+    stopifnot(startsWith(dir, approved))
+  }
+
+  old <- stamp::st_opts(.get = TRUE)
+  withr::defer(do.call(stamp::st_opts, old), envir = envir)
+  stamp::st_opts(versioning = "content", retain_versions = Inf,
+    default_format = "qs2", meta_format = "both")
+  stamp::st_init(root = dir, alias = paste0("pipload-", basename(dir)),
+    verbose = FALSE)
+  return(dir)
+}
