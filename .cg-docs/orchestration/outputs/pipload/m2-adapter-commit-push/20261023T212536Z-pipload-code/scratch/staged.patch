+library(testthat)
+library(stamp)
+library(data.table)
+library(withr)
+library(fs)
+
+# These fixtures are preserved: stamp has no public alias-removal API.
+m2_stores <- Sys.getenv("PIPLOAD_TEST_STORE_ROOT",
+  unset = file.path(tempdir(), "pipload-m2-stores"))
+
+m2_guard <- function(path, root = m2_stores) {
+  stopifnot(length(path) == 1L, !is.na(path), fs::is_absolute_path(path))
+  parts <- strsplit(gsub("\\\\", "/", path), "/", fixed = TRUE)[[1L]]
+  stopifnot(!any(parts %in% c(".", "..")))
+  cursor <- path
+  repeat {
+    target <- Sys.readlink(cursor)
+    if (isTRUE(fs::is_link(cursor)) ||
+        (length(target) == 1L && !is.na(target) && nzchar(target))) {
+      stop("Linked or junction fixture ancestry is forbidden")
+    }
+    parent <- dirname(cursor)
+    if (identical(parent, cursor)) break
+    cursor <- parent
+  }
+  resolved <- as.character(fs::path_real(path))
+  approved <- as.character(fs::path_real(root))
+  if (.Platform$OS.type == "windows") {
+    stopifnot(startsWith(tolower(resolved), paste0(tolower(approved), "/")))
+  } else {
+    stopifnot(startsWith(resolved, paste0(approved, "/")))
+  }
+  return(resolved)
+}
+
+if (!dir.exists(m2_stores)) {
+  if (!identical(m2_stores, file.path(tempdir(), "pipload-m2-stores"))) {
+    stop("PIPLOAD_TEST_STORE_ROOT must name an existing isolated directory")
+  }
+  m2_guard(tempdir(), dirname(tempdir()))
+  stopifnot(dir.create(m2_stores))
+}
+m2_guard(m2_stores, dirname(m2_stores))
+
+m2_fixture <- function(envir = parent.frame(), meta_format = "both") {
+  old <- stamp::st_opts(.get = TRUE)
+  withr::defer(do.call(stamp::st_opts, old), envir = envir)
+  stamp::st_opts(versioning = "content", retain_versions = Inf,
+    default_format = "qs2", meta_format = meta_format,
+    warn_missing_pk_on_load = FALSE, require_pk_on_load = FALSE)
+  # Check the existing parent before creating a uniquely owned child.
+  m2_guard(m2_stores, dirname(m2_stores))
+  root <- tempfile(paste0("phase1-", Sys.getpid(), "-"), tmpdir = m2_stores)
+  stopifnot(!file.exists(root), dir.create(root))
+  root <- m2_guard(root)
+  alias <- paste0("pipload-m2-", basename(root))
+  stamp::st_init(root = root, alias = alias, verbose = FALSE)
+  return(list(root = root, alias = alias))
+}
+
+m2_schema <- function() {
+  list(unit = list(type = "character", shape = "scalar", required = TRUE,
+    nullable = FALSE, allow_na = FALSE))
+}
+
+m2_request <- function(path, format, parents = list(), unit = "fixture") {
+  descriptor <- list(hash = strrep("a", 64L), algorithm = "sha256",
+    schema = "1")
+  list(schema = 1L, path = path, root = !length(parents), parents = parents,
+    required_components = c("calculation", "helper"),
+    components = list(calculation = descriptor, helper = descriptor),
+    semantic_schema = m2_schema(), semantic = list(unit = unit),
+    format = format)
+}
+
+m2_decode <- function(text) {
+  stopifnot(is.character(text), length(text) == 1L, !is.na(text),
+    nzchar(text), nchar(text) %% 2L == 0L, grepl("^[0-9a-f]+$", text))
+  starts <- seq.int(1L, nchar(text), by = 2L)
+  unserialize(as.raw(strtoi(substring(text, starts, starts + 1L), 16L)))
+}
+
+m2_capture <- function(saved, path, fixture) {
+  stopifnot(is.character(saved$version_id), length(saved$version_id) == 1L,
+    !is.na(saved$version_id), nzchar(saved$version_id))
+  info <- stamp::st_info(path, alias = fixture$alias)
+  stopifnot(identical(info$catalog$latest_version_id, saved$version_id))
+  directory <- m2_guard(info$snapshot_dir, fixture$root)
+  return(list(directory = directory, pin = saved$version_id))
+}
+
+m2_expect_table <- function(actual, expected) {
+  expect_true(is.data.frame(actual))
+  expect_identical(names(actual), names(expected))
+  expect_identical(nrow(actual), nrow(expected))
+  for (name in names(expected)) expect_identical(actual[[name]], expected[[name]])
+}
+
+test_that("metadata-only is appended without changing existing formals", {
+  expected <- formals(function(id, format = "qs2", version = NULL,
+    alias = NULL, verbose = getOption("pipload.verbose"),
+    metadata_only = FALSE) NULL)
+  expect_identical(formals(pip_read), expected)
+  expected_write <- formals(function(x, id, format = "qs2", metadata = list(),
+    code = NULL, alias = NULL, pk = NULL,
+    verbose = getOption("pipload.verbose"), ...) NULL)
+  expect_identical(formals(pip_write), expected_write)
+})
